{
  "name": "@ai-study/api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node src/seed.js",
    "pretest": "prisma db push --skip-generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-study/domain": "1.0.0",
    "@ai-study/shared-schemas": "1.0.0",
    "@huggingface/inference": "^4.13.32",
    "@prisma/client": "^5.14.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.1.2",
    "pino-pretty": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
