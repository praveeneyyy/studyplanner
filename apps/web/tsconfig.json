{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@ai-study/api-client": ["../../packages/api-client/src/index.ts"],
      "@ai-study/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@ai-study/domain": ["../../packages/domain/src/index.ts"],
      "@ai-study/shared-schemas": ["../../packages/shared-schemas/src/index.ts"]
    }
  },
  "include": ["src"]
}
